.new-connection-page-container {
    padding: 12px;
}

.page-header {
    font-size: 18px;
    -unity-font-style: bold;

    margin-bottom: 8px;
}

.primary-button {
    font-size: 14px;
    -unity-font-style: bold;

    margin-top: 8px;
    padding: 4px;
}

.connection-mode-group {
    margin-bottom: 8px;
}

.connection-mode-group .unity-radio-button-group__container {
    flex-direction: row;
}

.connection-mode-group .unity-radio-button {
    margin-right: 12px;
}

.resolved-url-hint {
    font-size: 11px;
    opacity: 0.7;

    margin-top: 2px;
    margin-bottom: 4px;
    margin-left: 2px;
}

.challenge-identity-prompt-container {
    display: flex;
    align-items: center;
    
    padding: 12px;
}

.identity-prompt-header {
    font-size: 14px;
}

#identity-prompt-label {
    font-size: 24px;
    -unity-font-style: bold;
}